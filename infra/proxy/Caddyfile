# CONTIX – reverzní proxy a statický web.
#   CONTIX_DOMAIN    adresa serveru (contix.firma.cz); prázdné = jen HTTP na :80 (vývoj, za jinou proxy)
#   CONTIX_TLS_MODE  auto     – veřejný certifikát (Let's Encrypt), server musí být dostupný z internetu
#                    internal – vlastní certifikační autorita Caddy (interní síť bez CA);
#                               kořenový certifikát se instaluje do klientů (viz docs/04_operations/install.md)
#                    files    – vlastní certifikát /certs/cert.pem + /certs/key.pem (např. od interní CA zákazníka)
{
	skip_install_trust
}

{$CONTIX_DOMAIN::80} {
	import tls-{$CONTIX_TLS_MODE:auto}.caddy
	encode zstd gzip

	# metriky jen z interní sítě (Prometheus se připojuje přímo na api:3000)
	handle /api/metrics {
		respond 404
	}

	# WebDAV pro úpravy v desktopovém Word / Excel (token v cestě – nelogovat)
	handle /dav/* {
		log_skip
		reverse_proxy api:3000
	}

	handle /api/* {
		# IP klienta pro audit a omezení MCP – Caddy nepřebírá X-Forwarded-For od klienta (není důvěryhodná proxy)
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		# CSP webu (v1.12, ADR-108) – vite preview v e2e testech čte tento řádek, testy tak běží se stejnou politikou
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		# statické soubory s otiskem v názvu lze cachovat natrvalo
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}
