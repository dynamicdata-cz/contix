# CONTIX – konfigurace serveru (docker compose --profile full).
# install.sh tento soubor zkopíruje do .env a vygeneruje tajemství. Soubor .env NEPATŘÍ do gitu ani do záloh mimo server.

# --- Adresa a TLS ---
CONTIX_DOMAIN=contix.firma.cz
# auto = veřejný certifikát (Let's Encrypt) | internal = vlastní CA Caddy (interní síť) | files = ./certs/cert.pem + key.pem
CONTIX_TLS_MODE=internal
HTTP_PORT=80
HTTPS_PORT=443
APP_URL=https://contix.firma.cz

# --- Tajemství (install.sh vygeneruje) ---
APP_SECRET=
POSTGRES_PASSWORD=
METRICS_TOKEN=

# --- První administrátor (vytvoří se při prvním startu; dočasné heslo je v logu API) ---
ADMIN_EMAIL=admin@firma.cz

# --- Verze obrazů (balíček pro zákazníka nastaví sám) ---
CONTIX_TAG=local

# --- Zálohy ---
TZ=Europe/Prague
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups
# BACKUP_AGE_RECIPIENT=age1...    # veřejný klíč age – zálohy se šifrují (privátní klíč NEUKLÁDEJTE na server)
# BACKUP_COPY_DIR=/offsite        # kopie mimo server (připojený NAS) – v kontejneru; viz docs/04_operations/backup.md

# --- SSO (volitelně) – viz .env.example ---
# Od v0.82 lze SSO i přihlášení účty AD nastavit v Administrace → Přihlášení (bez úprav tohoto souboru).
# OIDC_ISSUER=https://adfs.firma.cz/adfs
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Firemní účet (AD)

# --- Wazuh (volitelně, read-only účet) ---
# WAZUH_API_URL=https://wazuh-manager.firma.local:55000
# WAZUH_API_USER=contix-ro
# WAZUH_API_PASSWORD=

# --- Převodní služba dokumentů (v0.24) – PDF z Wordu/Excelu, vyhledávání v souborech, porovnání verzí ---
# Běží jako kontejner "converter" v interní síti. Vlastní písma (Aptos, firemní) nahrajte do ./fonts a restartujte converter.
# CONVERTER_URL=http://converter:3100   # výchozí; prázdná hodnota převody vypne
# CONVERTER_MEM=2g

# Identity a přístupy (Entra ID) – jen pro národní cloudy Microsoftu, jinak neměnit
# ENTRA_LOGIN_URL=https://login.microsoftonline.com
# GRAPH_URL=https://graph.microsoft.com

# Licence AGPL-3.0 (v1.15): odkaz na zdrojový kód této instalace, zobrazí se v menu aplikace.
# Provozujete-li upravenou verzi, uveďte odkaz na upravený kód.
# CONTIX_SOURCE_URL=https://github.com/dynamicdata-cz/contix   (výchozí; změňte jen u upravené verze – AGPL)

# Legislativa – zdroj znění předpisů ze Sbírky:
#   auto (výchozí) = REST API, je-li nastaven klíč, jinak otevřená data bez registrace (SPARQL + RSS),
#   api / opendata = vynutit zdroj, off = nestahovat (jen ručně vedené předpisy a normy).
# Odchozí HTTPS: opendata.eselpoint.gov.cz a e-sbirka.gov.cz (otevřená data, RSS), api.e-sbirka.gov.cz (REST API).
# ESBIRKA_SOURCE=auto
# ESBIRKA_SPARQL_URL=https://opendata.eselpoint.gov.cz/sparql
# ESBIRKA_RSS_URL=https://e-sbirka.gov.cz/rss/zmeny
# Když otevřená data nevrátí text znění, přečte se z webu e-Sbírky (veřejný JSON webové aplikace, bez klíče); off = vypnout
# ESBIRKA_WEB_FALLBACK=on
# ESBIRKA_WEB_URL=https://e-sbirka.gov.cz/sbr-cache
# REST API e-Sbírky (přístupový klíč z registrace klienta u Ministerstva vnitra):
# ESBIRKA_API_URL=https://api.e-sbirka.gov.cz
# ESBIRKA_API_KEY=
# Předpisy EU (EUR-Lex / CELLAR Úřadu pro publikace EU, bez registrace): on (výchozí) / off.
# Odchozí HTTPS: publications.europa.eu (SPARQL i texty).
# EURLEX_SOURCE=on
# EURLEX_SPARQL_URL=https://publications.europa.eu/webapi/rdf/sparql

# ARES – načtení dodavatele / společnosti podle IČO nebo názvu (veřejné API MF ČR, bez registrace): on (výchozí) / off.
# Odchozí HTTPS: ares.gov.cz.
# ARES_SOURCE=on
# ARES_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest

# --- Odchozí proxy (v0.54+: stahování veřejných zdrojů hrozeb CISA KEV a EPSS, ARES, e-Sbírka) ---
# Pokud server chodí na internet přes proxy. Interní služby VŽDY vyjměte v NO_PROXY
# (databáze, převodník, Open WebUI / Ollama, Wazuh), jinak by se k nim API nepřipojilo.
# HTTPS_PROXY=http://proxy.firma.local:3128
# NO_PROXY=localhost,127.0.0.1,db,converter,host.docker.internal,.firma.local
