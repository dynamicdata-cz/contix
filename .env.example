# --- API ---
PORT=3000
DATABASE_URL=postgres://contix:contix@localhost:5432/contix
CORS_ORIGINS=http://localhost:5173
# Veřejná adresa webu (pro SSO redirect); v produkci např. https://contix.firma.cz
APP_URL=http://localhost:5173
# Tajný klíč (min. 32 znaků) – v produkci POVINNÝ, např.: openssl rand -base64 48
# APP_SECRET=

# --- První administrátor (vytvoří se při startu, pokud je DB prázdná) ---
# ADMIN_EMAIL=admin@firma.cz
# ADMIN_PASSWORD=          # prázdné = vygeneruje se dočasné heslo a vypíše do logu

# --- SSO: Microsoft Entra ID ---
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# --- SSO: AD FS (on-prem Active Directory) / Keycloak / jiný OIDC ---
# OIDC_ISSUER=https://adfs.firma.cz/adfs
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Firemní účet (AD)
# OIDC_SCOPES=openid profile email allatclaims

# --- SSO: Google Workspace ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Wazuh Server API (read-only účet!) ---
# WAZUH_API_URL=https://wazuh-manager.firma.local:55000
# WAZUH_API_USER=contix-ro
# WAZUH_API_PASSWORD=
# WAZUH_VERIFY_TLS=true

# --- Síťový sken (nmap) – ve výchozím stavu vypnuto ---
SCAN_ENABLED=false
# Pouze tyto rozsahy smí být skenovány (čárkou oddělené CIDR)
SCAN_ALLOWED_CIDRS=
NMAP_PATH=nmap

# --- AI asistent ---
# Nastavuje se v aplikaci: Administrace → AI asistent (adresa Ollama / Open WebUI, model, API klíč – šifrovaně v DB).

# --- Monitoring ---
# Bearer token pro GET /api/metrics (Prometheus); bez něj je endpoint vypnutý. Např.: openssl rand -hex 24
# METRICS_TOKEN=

# --- Nasazení (docker compose --profile full) ---
# CONTIX_DOMAIN=contix.firma.cz   # Caddy získá TLS certifikát automaticky (porty 80/443 musí být dostupné)
# HTTP_PORT=8080
# HTTPS_PORT=8443
# POSTGRES_PASSWORD=              # silné heslo databáze

# --- Zálohy (služba backup) ---
# BACKUP_TIME=02:30               # denní záloha (čas kontejneru, TZ)
# TZ=Europe/Prague
# BACKUP_KEEP_DAYS=14
# BACKUP_AGE_RECIPIENT=age1...    # veřejný klíč age – zálohy se šifrují (privátní klíč NEUKLÁDEJTE na server)
# BACKUP_COPY_DIR=/offsite        # kopie mimo server (připojený NAS / síťový disk)
